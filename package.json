{
  "name": "frontend-gis-layers-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,ts,json,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,ts,json,html,md}\"",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,html,md,yml}": "prettier --write"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vedro": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.0"
  }
}
